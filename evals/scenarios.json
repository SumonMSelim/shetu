    {
      "id": "bangla-costs-language",
      "kind": "language",
      "input": "\u09a8\u09c7\u09a6\u09be\u09b0\u09b2\u09cd\u09af\u09be\u09a8\u09cd\u09a1\u09b8\u09c7 \u0995\u09ae\u09cd\u09aa\u09bf\u0989\u099f\u09be\u09b0 \u09b8\u09be\u09af\u09bc\u09c7\u09a8\u09cd\u09b8\u09c7 \u09ae\u09be\u09b8\u09cd\u099f\u09be\u09b0\u09cd\u09b8 \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u0987\u0964 \u0995\u09cb\u09a8 \u0995\u09cb\u09a8 \u09aa\u09cd\u09b0\u09cb\u0997\u09cd\u09b0\u09be\u09ae \u0986\u099b\u09c7, \u0996\u09b0\u099a \u0995\u09a4, \u0986\u09b0 \u0995\u09bf\u09ad\u09be\u09ac\u09c7 \u0986\u09ac\u09c7\u09a6\u09a8 \u0995\u09b0\u09ac?",
      "expect": {
        "toolsMustInclude": [
          "get_programmes"
        ],
        "grounded": true,
        "bengaliScript": true,
        "noEnglishSwitch": true,
        "mustNotContain": [
          "I'll answer in English"
        ],
        "noCjk": true
      },
      "judge": "honesty"
    },
    {
      "id": "bangla-scam-language",
      "kind": "language",
      "input": "\u098f\u0995\u099f\u09be \u098f\u099c\u09c7\u09a8\u09cd\u09b8\u09bf \u09ac\u09b2\u099b\u09c7 \u099c\u09be\u09b0\u09cd\u09ae\u09be\u09a8\u09bf\u09a4\u09c7 \u09ad\u09bf\u09b8\u09be \u0997\u09cd\u09af\u09be\u09b0\u09be\u09a8\u09cd\u099f\u09bf \u09a6\u09bf\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7, \u0986\u09b0 \u0993\u09a6\u09c7\u09b0 \u0995\u09be\u099b\u09c7 \u09e8 \u09b2\u09be\u0996 \u099f\u09be\u0995\u09be \u0986\u0997\u09c7 \u09a6\u09bf\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964 \u098f\u099f\u09be \u0995\u09bf \u09a0\u09bf\u0995?",
