      "expect": {
        "toolsMustInclude": [
          "get_red_flags",
          "get_scholarships"
        ],
        "mustContain": [
          "NL Scholarship"
        ],
        "mustNotContain": [
          "that is a legitimate"
        ],
        "groundedLinks": true
      },
      "judge": "honesty"
    },
    {
      "id": "proof-of-funds-distinction",
      "kind": "honesty",
