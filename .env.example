# ---------------------------------------------------------------------------
# Shetu environment configuration
# Copy to .env.local for local runs, or set these as App Runner / ECS env vars.
# NEVER commit real values. .env* is gitignored.
# ---------------------------------------------------------------------------

# --- App ---
# Public base URL of the deployed app (used by Auth.js for callbacks).
# Local: http://localhost:3000   Prod: https://shetu.mol.la
AUTH_URL=http://localhost:3000

# Random 32+ byte secret. Generate with: openssl rand -base64 33
AUTH_SECRET=

# --- Google OAuth (Auth.js) ---
# Create at https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- AWS / Bedrock ---
# Region where you have Bedrock model access and where S3/DynamoDB live.
AWS_REGION=us-east-1

# Cross-region inference profile IDs (recommended over bare model IDs).
SHETU_MODEL_ID=us.anthropic.claude-sonnet-4-6
SHETU_FAST_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Credentials: in production these come from the task/instance IAM role and are
# NOT set here. For local development only, use `aws configure` / SSO, or set:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Storage ---
# S3 bucket backing the document Vault.
SHETU_VAULT_BUCKET=shetu-vault

# DynamoDB table holding users, profiles, mentorship requests, and doc metadata.
SHETU_TABLE_NAME=shetu-app
